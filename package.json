{
  "name": "ui-library-comparison",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter @uilc/site dev",
    "build": "pnpm -r --filter \"./builds/*\" --filter \"./baselines/*\" build",
    "test": "pnpm -r --filter \"./builds/*\" test",
    "measure": "tsx scripts/measure.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "site:dev": "pnpm --filter @uilc/site dev",
    "site:build": "pnpm --filter @uilc/site build",
    "site:screens": "tsx scripts/screens.ts",
    "site:check": "tsx scripts/site-check.ts",
    "test:api": "vitest run --root api",
    "fixture:generate": "tsx packages/fixture/src/generate.ts && tsx scripts/check-fixture.ts",
    "fixture:check": "tsx scripts/check-fixture.ts",
    "typecheck": "tsc --noEmit -p packages/fixture/tsconfig.json && tsc --noEmit -p packages/harness/tsconfig.json && tsc --noEmit -p packages/criteria/tsconfig.json && tsc --noEmit -p site/tsconfig.json && tsc --noEmit -p tsconfig.api.json",
    "lint": "biome lint builds",
    "format:check": "biome format builds",
    "new-build": "tsx scripts/new-build.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^26.4.1",
    "axe-core": "^4.13.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "puppeteer-core": "^25.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "openai": "^7.16.0"
  }
}
